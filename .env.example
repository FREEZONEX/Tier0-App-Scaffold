# APP_ID is platform-owned: Preview/deployed runs get the agent-platform App
# UUID. local-app is a local-development placeholder only.
APP_ID=local-app
VITE_BASE_PATH=

# Tier0 SDK auth/connectivity env (TIER0_API_HOST, TIER0_API_KEY,
# TIER0_APP_COLLECTION_PREFIX, ...) is injected automatically by the platform in
# Preview and deployed runs. Do not add TIER0_* values here or expose them in
# generated app UI. There is no app database: app data lives in app-owned UNS
# collections (see docs/uns-data.md).
