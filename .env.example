# APP_ID is platform-owned: Preview/deployed runs get the agent-platform App
# UUID. local-app is a local-development placeholder only.
APP_ID=local-app
VITE_BASE_PATH=

# Tier0 SDK and App data connectivity (TIER0_API_HOST, TIER0_MQTT_URL,
# TIER0_WORKSPACE_ID, ...) is provided by the platform in Preview and deployments;
# no credential is needed there, the node proxy injects the App's key.
# Do not add TIER0_* values here or expose them in generated app UI.
# Local development only: export TIER0_API_HOST and TIER0_API_KEY in your shell.
