# APP_ID is platform-owned: Preview/deployed runs get the agent-platform App
# UUID. local-app is a local-development placeholder only.
APP_ID=local-app
VITE_BASE_PATH=

# Tier0 SDK and App data connectivity (TIER0_API_HOST, TIER0_MQTT_HOST/PORT,
# TIER0_WORKSPACE_ID, ...) and the App's key TIER0_API_KEY are provided by the
# platform in the App's process in Preview and deployments.
# Do not add TIER0_* values here or expose them in generated app UI.
# Local development only: export TIER0_API_HOST and TIER0_API_KEY (a personal
# key or an external App's key) in your shell.
